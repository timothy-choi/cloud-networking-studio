# Copy to `.env` in the repository root for docker-compose.prod.yml overrides.
# docker compose automatically loads `.env` from the project directory.
#
# Local stack (Postgres + API + UI + Caddy):
#   docker compose -f docker-compose.prod.yml up -d
# For AWS RDS (or any external DB), set DATABASE_URL in this file — see docs/RDS.md.

# --- Postgres (must match DATABASE_URL credentials if you change them) ---
# POSTGRES_DB=cloud_networking_studio
# POSTGRES_USER=cns_user
# POSTGRES_PASSWORD=change-me-strong-password

# --- Backend DSN (defaults in compose point at the `postgres` service) ---
# DATABASE_URL=postgresql://cns_user:change-me-strong-password@postgres:5432/cloud_networking_studio

# --- Backend behavior ---
# CNS_ENVIRONMENT=production
# CNS_CONTROLLER_MODE=manual
# Step 34 auth: set true in production so anonymous clients cannot use data APIs without a JWT.
# Production smoke (scripts/prod_smoke_test.sh) expects 401 on unauthenticated topology POST when this is true.
# AUTH_REQUIRE_LOGIN=true
# AUTH_SECRET_KEY=use-openssl-rand-hex-32-or-longer
# Comma-separated browser origins (scheme+host+port). Include your Vercel URL(s) and EC2/http(s) UI origins.
# CNS_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,https://your-app.vercel.app

# Optional regex for extra CORS origins (e.g. all Vercel previews). Example:
# CNS_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Custom API domain (merge docker-compose.caddy-https.yml; production default on main) ---
# Stable production API host (GitHub Actions default; override with repo variable CNS_PRODUCTION_API_HOST):
# CNS_CADDY_SITE_ADDRESS=api.cloudnetstudio.com
# SSLIP_HOST=api.cloudnetstudio.com
# CNS_SSLIP_HOST=api.cloudnetstudio.com
# CADDYFILE_CADDY=./deploy/Caddyfile.public-https
# CNS_CADDY_AUTO_HTTPS=on
# Never `docker compose down -v` or `docker volume rm` on caddy_data/caddy_config in production (LE rate limits).
# For a different hostname, set the three host vars to the same FQDN (e.g. api.example.com).
#
# --- sslip.io (merge docker-compose.sslip.yml; ephemeral CI / quick labs) ---
# SSLIP_HOST=203.0.113.7.sslip.io
# CNS_SSLIP_HOST=203.0.113.7.sslip.io
# CADDYFILE_SSLIP=./deploy/Caddyfile.sslip
# CNS_CADDY_AUTO_HTTPS=on
# CNS_CADDY_SITE_ADDRESS=203.0.113.7.sslip.io
#
# HTTP-only (ephemeral CI / local debugging — no TLS, no redirect):
# CADDYFILE_SSLIP=./deploy/Caddyfile.prod
# CNS_CADDY_AUTO_HTTPS=off
# CNS_CADDY_SITE_ADDRESS=:80
#
# --- Frontend build (rebuild image after changing) ---
# VITE_API_BASE_URL=/api

# --- Go runtime runner (optional; docker-compose.prod.yml passes these through) ---
# RUNTIME_EXECUTOR=go
# GO_RUNNER_URL=http://runner:8090
# CNS_USE_FAKE_DOCKER=1 forces the in-process fake Docker provider and disables Go delegation (CI/tests).

# --- Reverse proxy host port ---
# CADDY_HTTP_PORT=80
