# Copy to `.env` in the repository root for docker-compose.prod.yml overrides.
# docker compose automatically loads `.env` from the project directory.

# --- Postgres (must match DATABASE_URL credentials if you change them) ---
# POSTGRES_DB=cloud_networking_studio
# POSTGRES_USER=cns_user
# POSTGRES_PASSWORD=change-me-strong-password

# --- Backend DSN (defaults in compose point at the `postgres` service) ---
# DATABASE_URL=postgresql://cns_user:change-me-strong-password@postgres:5432/cloud_networking_studio

# --- Backend behavior ---
# CNS_ENVIRONMENT=production
# CNS_CONTROLLER_MODE=manual
# Comma-separated browser origins (scheme+host+port). Include your public URL on EC2.
# CNS_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# --- Frontend build (rebuild image after changing) ---
# VITE_API_BASE_URL=/api

# --- Reverse proxy host port ---
# CADDY_HTTP_PORT=80
