# Copy to `backend/.env` when running uvicorn from the `backend/` directory.
# Pydantic loads `.env` from the current working directory (see app/core/config.py).

# PostgreSQL (default matches docker-compose.yml publishing Postgres on host 5433)
DATABASE_URL=postgresql://cns_user:cns_password@localhost:5433/cloud_networking_studio

# Shown on GET /health
# CNS_ENVIRONMENT=development

# --- Auth (JWT + bcrypt) ---
# Required in production: long random string (openssl rand -hex 32).
# AUTH_SECRET_KEY=change-me-in-production-min-32-characters-long
# Optional access token TTL (minutes).
# AUTH_TOKEN_EXPIRE_MINUTES=60
# If true, all protected routes require Authorization: Bearer <JWT>.
# If false (default), local dev can use an implicit bootstrap dev user without a token.
# AUTH_REQUIRE_LOGIN=false

# manual | (future modes)
# CNS_CONTROLLER_MODE=manual

# Comma-separated CORS origins for the FastAPI app (browsers hitting the API directly).
# For local Vite on 5174, defaults in code are usually enough; set explicitly if you use another port.
# Include your Vercel production URL and https://<EIP>.sslip.io when the UI on Vercel calls the EC2 API.
# CNS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://your-app.vercel.app

# Optional Starlette allow_origin_regex (e.g. Vercel preview deployments):
# CNS_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Tests only: pytest sets CNS_USE_FAKE_DOCKER=1 in conftest — do not set in real deployments.
# CNS_USE_FAKE_DOCKER=0

# --- Step 54A: notifications / email ---
# EMAIL_PROVIDER=console
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=cns@localhost
# SMTP_USE_TLS=true

# --- Step 54B: team invitations ---
# CNS_FRONTEND_APP_URL=https://app.cloudnetstudio.com
# CNS_INVITATION_EXPIRE_DAYS=7
# CNS_RATE_LIMIT_INVITE_PER_USER=20
