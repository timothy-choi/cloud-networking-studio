# Copy to `backend/.env` when running uvicorn from the `backend/` directory.
# Pydantic loads `.env` from the current working directory (see app/core/config.py).

# PostgreSQL (default matches docker-compose.yml publishing Postgres on host 5433)
DATABASE_URL=postgresql://cns_user:cns_password@localhost:5433/cloud_networking_studio

# Shown on GET /health
# CNS_ENVIRONMENT=development

# manual | (future modes)
# CNS_CONTROLLER_MODE=manual

# Comma-separated CORS origins for the FastAPI app (browsers hitting the API directly).
# For local Vite on 5174, defaults in code are usually enough; set explicitly if you use another port.
# CNS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Tests only: pytest sets CNS_USE_FAKE_DOCKER=1 in conftest — do not set in real deployments.
# CNS_USE_FAKE_DOCKER=0
