# Reverse proxy for docker-compose.prod.yml — :80 only (TLS left to ALB, Caddy elsewhere, or extend this file).
#
# For public HTTPS on EC2 with automatic certs via sslip.io, merge **docker-compose.sslip.yml**
# and **deploy/Caddyfile.sslip** (see docs/CICD_DEPLOYMENT.md).
#
# HTTP-only on sslip (e.g. ephemeral CI): set **CADDYFILE_SSLIP=./deploy/Caddyfile.prod** in `.env` so the
# sslip compose overlay still publishes 443 but Caddy serves only **:80** with the routes below — no
# `{$SSLIP_HOST}` TLS site, so there is **no automatic HTTP→HTTPS redirect** (see docker-compose.sslip.yml).
# Pair with **CNS_CADDY_AUTO_HTTPS=off** in `.env` as documentation that TLS is intentionally disabled.
#
# Routing:
#   - /api/* → backend:8000 with /api prefix stripped so FastAPI sees /health, /topologies, … (same as direct uvicorn paths).
#   - /     → frontend:80 (static SPA + nginx).
#
# Browsers and VITE_API_BASE_URL=/api call /api/… on this host; direct backend access (e.g. :8000) is unchanged.

{
	admin off
}

:80 {
	route {
		# Strip /api prefix before reverse_proxy (upstream URI is /health, /topologies, …).
		handle_path /api/* {
			reverse_proxy backend:8000
		}
		handle {
			reverse_proxy frontend:80
		}
	}
}
