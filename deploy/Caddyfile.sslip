# Production reverse proxy: public HTTPS on sslip.io (Let's Encrypt) + gzip.
# Use with docker-compose.prod.yml + docker-compose.sslip.yml (see docs/CICD_DEPLOYMENT.md).
#
# **{$CNS_SSLIP_HOST}** must match **SSLIP_HOST** in `.env` (e.g. 203.0.113.7.sslip.io). ACME state persists in
# Compose volumes **caddy_data** / **caddy_config** (see docker-compose.sslip.yml).
#
# For CI/ephemeral HTTP-only stacks, set **CADDYFILE_SSLIP=./deploy/Caddyfile.prod**,
# **CNS_CADDY_AUTO_HTTPS=off**, **CNS_CADDY_SITE_ADDRESS=:80** (see docker-compose.sslip.yml).
#
# Routing:
#   - /api/* → backend:8000 (prefix stripped)
#   - /     → frontend:80

{
	admin off
}

{$CNS_SSLIP_HOST} {
	encode gzip
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
