# Production reverse proxy with optional public HTTPS on sslip.io + HTTP on :80.
# Use together with docker-compose.prod.yml + docker-compose.sslip.yml (see docs/CICD_DEPLOYMENT.md).
#
# Routing (both :80 and {$SSLIP_HOST}):
#   - /api/* → backend:8000 (prefix stripped; FastAPI paths are /health, /topologies, …)
#   - /     → frontend:80
#
# {$SSLIP_HOST} must be set (e.g. 203.0.113.7.sslip.io). Caddy obtains a public certificate automatically.

{
	admin off
}

:80 {
	route {
		handle_path /api/* {
			reverse_proxy backend:8000
		}
		handle {
			reverse_proxy frontend:80
		}
	}
}

{$SSLIP_HOST} {
	route {
		handle_path /api/* {
			reverse_proxy backend:8000
		}
		handle {
			reverse_proxy frontend:80
		}
	}
}
