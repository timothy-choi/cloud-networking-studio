# Copy to `frontend/.env` for local Vite (`npm run dev` / `npm run preview`).

# Local dev default: same-origin `/api` (Vite proxy → FastAPI). Absolute production URLs
# in VITE_API_BASE_URL are ignored in dev unless you opt in with VITE_USE_REMOTE_API=true.
# VITE_API_BASE_URL=/api

# Intentionally call a remote API from local Vite (e.g. production smoke):
# VITE_USE_REMOTE_API=true
# VITE_API_BASE_URL=https://api.cloudnetstudio.com/api

# Vercel / split deployment: browser calls the EC2 API (set at build time in CI).
# Example (replace with your API host):
# VITE_API_BASE_URL=https://203.0.113.7.sslip.io/api

# Override where Vite proxies `/api` (default http://127.0.0.1:8000 — see vite.config.ts).
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Production Docker image: pass as build-arg (see frontend/Dockerfile and docker-compose.prod.yml).
# Default baked into the production image is /api (same-origin behind Caddy on EC2).
# VITE_API_BASE_URL=/api
