# Copy to terraform.tfvars (gitignored) and edit before apply.
# Do not commit real secrets, private keys, or overly-broad SSH CIDRs.

aws_region         = "us-east-1"
project_name       = "cns"
environment        = "prod"
key_name           = "my-keypair-name"
ssh_allowed_cidr   = "203.0.113.10/32" # your public IPv4 /32 for local or manual SSH (not GitHub Actions runners)
# Ephemeral CI in this repo sets SSH to 0.0.0.0/0 in the workflow — do not mirror that for long-lived prod unless you accept the risk.
instance_type      = "t3.medium"

# Ubuntu AMI (Canonical owner 099720109477). Default pattern matches noble 24.04 (hvm-ssd and hvm-ssd-gp3 prefixes).
ubuntu_version           = "24.04"
ubuntu_ami_name_pattern  = "ubuntu/images/hvm-ssd*/ubuntu-noble-24.04-amd64-server-*"
# If your region has no 24.04 image yet, try 22.04 jammy, e.g.:
# ubuntu_version          = "22.04"
# ubuntu_ami_name_pattern = "ubuntu/images/hvm-ssd*/ubuntu-jammy-22.04-amd64-server-*"

# Optional overrides:
# vpc_cidr           = "10.0.0.0/16"
# public_subnet_cidr = "10.0.1.0/24"
# public_subnet_b_cidr = "10.0.2.0/24" # second AZ; used when rds_enabled

# Optional RDS PostgreSQL — see ../../docs/RDS.md (do not commit passwords)
# rds_enabled               = true
# rds_instance_class        = "db.t4g.micro" # or db.t3.micro
# rds_publicly_accessible   = false
# rds_master_password       = "use-tf-env-or-secret-not-this-file"
